{
  "name": "agent-traffic-control",
  "version": "1.0.1",
  "description": "Local-first ATC board for parallel LLM agent sessions",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --experimental-vm-modules tests/run.mjs",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": ["obsidian", "plugin", "agent", "atc"],
  "author": "Pieter van Schalkwyk",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "0.20.0",
    "obsidian": "^1.4.11",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "preact": "^10.19.0"
  }
}
